---
import Layout from "../layouts/Layout.astro"
import PaperInfo from "../components/paper/PaperInfo.astro"
import { Content as About } from "../components/md/about.md"
import { getCollection } from "astro:content"

const statusOrder = {
	"Work in Progress": 1,
	"Working Paper": 2,
	"Under Review": 3,
	"R&R": 4,
	Published: 5,
}

const papers = (await getCollection("papers")).sort((a, b) => {
	const statusDifference =
		statusOrder[b.data.status] - statusOrder[a.data.status]
	if (statusDifference !== 0) return statusDifference
	return new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
})

const sections = [
	{
		title: "Publications",
		id: "publications",
		papers: papers.filter((paper) => paper.data.status === "Published"),
	},
	{
		title: "Working Papers",
		id: "working-papers",
		papers: papers.filter((paper) =>
			["Working Paper", "Under Review", "R&R"].includes(paper.data.status),
		),
	},
	{
		title: "Research in Progress",
		id: "in-progress",
		papers: papers.filter((paper) => paper.data.status === "Work in Progress"),
	},
]
---

<Layout>
	<div class="space-y-size-xl">
		<article
			class="grid items-start gap-size-md md:grid-cols-[12rem_minmax(0,1fr)]"
		>
			<img
				class="w-full max-w-[12rem] mx-auto"
				src="/images/headshot_small.webp"
				alt="Headshot of Kyle Butts"
			/>
			<div class="prose flow">
				<About />
			</div>
		</article>

		<section id="papers" class="scroll-mt-size-md">
			<div class="space-y-size-xl">
				{
					sections
						.filter((section) => section.papers.length > 0)
						.map((section) => (
							<section id={section.id} class="scroll-mt-size-md">
								<h3 class="offset-border-left text-size-1 font-bold mb-size-xs">
									{section.title}
								</h3>
								<ul>
									{section.papers.map((paper) => (
										<li class="py-size-sm border-b border-zinc-200">
											<PaperInfo data={paper.data} slug={paper.id} compact />
										</li>
									))}
								</ul>
							</section>
						))
				}
			</div>
		</section>
	</div>
</Layout>
