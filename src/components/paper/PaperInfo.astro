---
import PaperLink from "./PaperLink.astro"
const { data, slug = "", includeSummary = false, compact = false } = Astro.props

// Write function to combine names with commas (including oxford comma and the word and)
function combineNames(names) {
	if (names.length === 0) {
		return ""
	} else if (names.length === 1) {
		return `${names[0]}`
	} else if (names.length === 2) {
		return `${names[0]} and ${names[1]}`
	} else {
		return `${names.slice(0, -1).join(", ")}, and ${names.slice(-1)}`
	}
}
const author_names = data.author
	? combineNames(data.author.map((author) => author.name))
	: ""

const paperInfo = (() => {
	switch (data.status) {
		case "Published":
			return data.journal
				? `<i>${data.journal}</i>${data.year ? `, ${data.year}` : ""}`
				: ""
		case "R&R":
			return data.journal ? `R&R at <i>${data.journal}</i>` : ""
		case "Under Review":
			return ""
		default:
			return ""
	}
})()

const includeLinks = true
---

<Fragment>
	<!-- TODO: color the decoration? -->
	<h2
		class:list={[
			"text-zinc-800",
			compact
				? "font-semibold text-[1.3125rem] leading-[1.35] [&_a:hover]:underline [&_a:focus-visible]:underline underline-offset-4 decoration-1"
				: "font-bold text-size-1 underline decoration-2 decoration-zinc-200 hover:decoration-zinc-400",
			{ "cursor-pointer": data.draft === false },
		]}
	>
		{
			data.draft === true ? (
				<Fragment set:html={data.title} />
			) : (
				<a href={`/papers/${slug}`} set:html={data.title} />
			)
		}
	</h2>

	{
		author_names != "" && (
			<p
				class:list={[
					compact
						? "mt-1.5 text-[0.9375rem] text-zinc-600 leading-[1.5]"
						: "mt-size-3xs text-size-0",
				]}
			>
				{author_names}
			</p>
		)
	}

	{
		paperInfo && (
			<p
				class:list={[
					compact
						? "mt-0.5 text-[0.9375rem] text-zinc-600 leading-[1.5]"
						: "mt-size-3xs text-kyle-highlight italic text-size--1",
				]}
				set:html={paperInfo}
			/>
		)
	}

	{
		includeLinks && (
			<p
				class:list={[
					compact
						? "mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-[0.875rem] text-kyle-highlight leading-[1.5]"
						: "mt-size-xs text-size--1",
				]}
			>
				{!includeSummary && (
					<PaperLink
						name="Details"
						url={`/papers/${slug}`}
						includeRightBar={!compact && (data.links || []).length > 0}
					/>
				)}
				{(data.links || []).map((link, i) => {
					return (
						<PaperLink
							name={link.name}
							url={link.url}
							includeRightBar={!compact && i < (data.links || []).length - 1}
						/>
					)
				})}
			</p>
		)
	}

	{
		includeSummary && (
			<p class="mt-size-sm text-size-0" set:html={data.summary} />
		)
	}
</Fragment>
