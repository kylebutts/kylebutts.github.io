---
import Layout from "../../layouts/Layout.astro"
import { getCollection } from "astro:content"
import "../../styles/listing.css"
const items = await getCollection("open-source")
---

<Layout>
  <h2 class="listing-heading offset-border-left">Open Source</h2>
  <p class="listing-intro">
    If you have questions regarding my open-source software, please try to ask me
    via opening an issue on GitHub. By answering your question there, I generate
    public information.
  </p>
  <ul class="listing">
    {items.map((repo) => (
      <li>
        <h3 class="listing-title">
          <a href={repo.data.url} set:html={repo.data.title} />
        </h3>
        <p class="listing-description" set:html={repo.data.description} />
      </li>
    ))}
  </ul>
</Layout>
