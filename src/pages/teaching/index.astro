---
import Layout from "../../layouts/Layout.astro"
import { getCollection } from "astro:content"
import "../../styles/listing.css"
const items = await getCollection("courses")
---

<Layout>
  <h2 class="listing-heading offset-border-left">Teaching</h2>
  <ul class="listing">
    {items.map((course) => (
      <li>
        <h3 class="listing-title">
          <a href={course.data.url} set:html={course.data.title} />
        </h3>
        <p class="listing-description" set:html={course.data.description} />
      </li>
    ))}
  </ul>
</Layout>
